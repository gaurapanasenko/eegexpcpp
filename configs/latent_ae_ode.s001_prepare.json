{
  "data": {
    "h5_path": "data/S001R01_8_prepare.h5",
    "h5_group": "0/0",
    "train_fraction": 0.9
  },
  "model": {
    "n_latent": 12,
    "encoder_hidden": [256, 256],
    "encoder_activation": "gelu",
    "ode": {
      "type": "nn",
      "hidden": [128, 128],
      "activation": "tanh"
    },
    "decoder_hidden": [256, 256],
    "decoder_activation": "gelu"
  },
  "loss": {
    "lambda_Y": 1.0,
    "lambda_dY": 1.0,
    "lambda_dZ": 1.0,
    "lambda_z1": 1.0,
    "lambda_l1": 1.0e-5
  },
  "train": {
    "epochs": 1000,
    "lr": 0.001,
    "weight_decay": 0.01,
    "adamw_betas": [0.9, 0.999],
    "adamw_eps": 1.0e-8,
    "grad_clip_norm": 0.0,
    "device": "cuda",
    "seed": 42,
    "log_every": 5,
    "checkpoint_dir": "checkpoints/latent_ae_ode_s001"
  }
}
