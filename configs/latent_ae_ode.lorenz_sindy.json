{
  "data": {
    "h5_path": "data/lorenz.h5",
    "h5_group": "0",
    "train_fraction": 0.9
  },
  "model": {
    "n_latent": 3,
    "encoder_hidden": [64, 32],
    "encoder_activation": "tanh",
    "ode": {
      "type": "sindy",
      "libraries": [
        {
          "type": "poly",
          "degree": 3,
          "include_interaction": true,
          "interaction_only": false,
          "include_bias": true
        }
      ],
      "xi_prune_every": 3000,
      "xi_threshold": 0.05
    },
    "decoder_hidden": [32, 64],
    "decoder_activation": "tanh"
  },
  "loss": {
    "lambda_Y": 1.0,
    "lambda_dY": 0,
    "lambda_dZ": 1.0e-1,
    "lambda_z1": 0,
    "lambda_l1_ae": 0,
    "lambda_l1_ode": 1.0e-3
  },
  "train": {
    "epochs": 10000,
    "lr": 1.0e-3,
    "weight_decay": 0.01,
    "adamw_betas": [0.9, 0.999],
    "adamw_eps": 1.0e-8,
    "grad_clip_norm": 0.0,
    "device": "cuda",
    "seed": 42,
    "log_every": 5,
    "checkpoint_dir": "checkpoints/latent_ae_ode_lorenz_sindy"
  }
}
